; Test that ECS queries with different subnets create separate cachedb entries
; This test SHOULD FAIL initially (returns wrong answer) and PASS after ECS-aware cachedb implementation
; 
; Test scenario:
; 1. Query from subnet 10.10.10.0/24 -> gets answer A (1.2.3.10)
; 2. Query from subnet 20.20.20.0/24 -> gets answer B (1.2.3.20)
; 3. Force time advance to clear in-memory cache but keep cachedb
; 4. Query from subnet 10.10.10.0/24 again -> should get answer A from cachedb (1.2.3.10)
; 5. Query from subnet 20.20.20.0/24 again -> should get answer B from cachedb (1.2.3.20)
;
; EXPECTED BEHAVIOR AFTER FIX:
;   - Different ECS subnets should create different cache keys in cachedb
;   - Each subnet retrieves its correct answer from cachedb
;
; CURRENT BEHAVIOR (FAIL):
;   - All ECS queries share the same cachedb key (no subnet differentiation)
;   - Second query from different subnet may get wrong cached answer
;   - This test will FAIL because cachedb doesn't distinguish subnets

server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	minimal-responses: no
	
	; ECS configuration - allow different source subnets
	send-client-subnet: 10.10.10.0/24
	client-subnet-always-forward: yes
	max-client-subnet-ipv4: 24
	
	; Put cachedb AFTER subnetcache to test if cachedb stores ECS variants
	module-config: "subnetcache cachedb iterator"
	
	verbosity: 3
	access-control: 127.0.0.1 allow_snoop

cachedb:
	backend: "testframe"
	secret-seed: "testvalue"

stub-zone:
	name: "."
	stub-addr: 193.0.14.129
CONFIG_END

SCENARIO_BEGIN Test cachedb stores separate entries for different ECS subnets

; K.ROOT-SERVERS.NET.
RANGE_BEGIN 0 200
	ADDRESS 193.0.14.129
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
. IN NS
SECTION ANSWER
. IN NS K.ROOT-SERVERS.NET.
SECTION ADDITIONAL
K.ROOT-SERVERS.NET.     IN      A       193.0.14.129
ENTRY_END

ENTRY_BEGIN
MATCH opcode subdomain
ADJUST copy_id copy_query
REPLY QR NOERROR
SECTION QUESTION
com. IN NS
SECTION AUTHORITY
com. IN NS a.gtld-servers.net.
SECTION ADDITIONAL
a.gtld-servers.net.	IN	A	192.5.6.30
ENTRY_END
RANGE_END

; a.gtld-servers.net.
RANGE_BEGIN 0 200
	ADDRESS 192.5.6.30
ENTRY_BEGIN
MATCH opcode subdomain
ADJUST copy_id copy_query
REPLY QR NOERROR
SECTION QUESTION
example.com. IN NS
SECTION AUTHORITY
example.com. IN NS ns.example.com.
SECTION ADDITIONAL
ns.example.com.	IN	A	1.2.3.5
ENTRY_END
RANGE_END

; ns.example.com. - responds with different answers based on ECS subnet
; This simulates a CDN that returns different IPs for different geographic regions
RANGE_BEGIN 0 200
	ADDRESS 1.2.3.5

; Response for subnet 10.10.10.0/24 (Region A)
; Unbound sends ECS to upstream, server responds with matching ECS
ENTRY_BEGIN
MATCH opcode qname qtype ednsdata
ADJUST copy_id copy_ednsdata_assume_clientsubnet
REPLY QR AA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 10 IN A 1.2.3.10
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; ECS in response from authoritative server
	00 08 		; option code = 8 (client subnet)
	00 07 		; length = 7 bytes
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0 (will be filled by subnetmod)
	0a 0a 0a 	; address = 10.10.10.0 (3 bytes for /24)
HEX_EDNSDATA_END
ENTRY_END

; Response for subnet 20.20.20.0/24 (Region B)  
ENTRY_BEGIN
MATCH opcode qname qtype ednsdata
ADJUST copy_id copy_ednsdata_assume_clientsubnet
REPLY QR AA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 10 IN A 1.2.3.20
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; ECS in response from authoritative server
	00 08 		; option code = 8 (client subnet)
	00 07 		; length = 7 bytes
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0 (will be filled by subnetmod)
	14 14 14 	; address = 20.20.20.0 (3 bytes for /24)
HEX_EDNSDATA_END
ENTRY_END
RANGE_END

; STEP 10: First query from subnet 10.10.10.0/24
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0
	0a 0a 0a 	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

STEP 20 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 10 IN A 1.2.3.10
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option echoed back
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	18 		; scope prefix-length = 24
	0a 0a 0a 	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

; STEP 30: Second query from different subnet 20.20.20.0/24
STEP 30 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0
	14 14 14 	; address = 20.20.20.0
HEX_EDNSDATA_END
ENTRY_END

STEP 40 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 10 IN A 1.2.3.20
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option echoed back
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	18 		; scope prefix-length = 24
	14 14 14 	; address = 20.20.20.0
HEX_EDNSDATA_END
ENTRY_END

; STEP 50: Advance time to expire in-memory cache but not cachedb
; The TTL is 10 seconds, so advancing 15 seconds should clear memory cache
; but cachedb should still have the entries
STEP 50 TIME_PASSES ELAPSE 15

; STEP 60: Query from subnet 10.10.10.0/24 again - should come from cachedb
; THIS IS THE CRITICAL TEST: Does cachedb return the correct subnet-specific answer?
; EXPECTED (after fix): 1.2.3.10
; CURRENT (before fix): May return 1.2.3.20 (wrong subnet's answer) or SERVFAIL
STEP 60 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0
	0a 0a 0a 	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

STEP 70 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
; CRITICAL: This should be 1.2.3.10 (subnet 10's answer), not 1.2.3.20
www.example.com. IN A 1.2.3.10
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	18 		; scope prefix-length = 24
	0a 0a 0a 	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

; STEP 80: Query from subnet 20.20.20.0/24 again - should come from cachedb
; EXPECTED (after fix): 1.2.3.20
; CURRENT (before fix): May return 1.2.3.10 (wrong subnet's answer) or SERVFAIL
STEP 80 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0
	14 14 14 	; address = 20.20.20.0
HEX_EDNSDATA_END
ENTRY_END

STEP 90 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
; CRITICAL: This should be 1.2.3.20 (subnet 20's answer), not 1.2.3.10
www.example.com. IN A 1.2.3.20
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	; client-subnet option
	00 08 		; option code = 8
	00 07 		; length = 7
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	18 		; scope prefix-length = 24
	14 14 14 	; address = 20.20.20.0
HEX_EDNSDATA_END
ENTRY_END

SCENARIO_END
