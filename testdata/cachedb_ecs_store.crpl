; Test that ECS responses ARE stored in cachedb with ECS-aware keys
; 
; CURRENT BEHAVIOR (test should show cachedb not storing ECS):
;   - Subnetmod marks ECS responses as "no_cache_store" 
;   - Cachedb does NOT store them
;   - After flush+expire, query goes upstream again
;
; EXPECTED AFTER FIX (test should show cachedb storing ECS):
;   - Cachedb stores ECS responses with subnet in key
;   - After flush, cachedb serves the response
;   - No upstream query needed
;
; Test detection: Upstream server only answers in time range [0-30]. 
; After flush+time_passes to T=50, if query succeeds, it came from cachedb.
; If query fails/times out, cachedb didn't have it (current behavior).

server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	minimal-responses: no
	send-client-subnet: 10.10.10.0/24
	client-subnet-always-forward: yes
	max-client-subnet-ipv4: 24
	module-config: "subnetcache cachedb iterator"
	verbosity: 2

cachedb:
	backend: "testframe"
	secret-seed: "testvalue"

stub-zone:
	name: "."
	stub-addr: 193.0.14.129
CONFIG_END

SCENARIO_BEGIN Test cachedb storage of ECS responses

; Root server
RANGE_BEGIN 0 100
	ADDRESS 193.0.14.129
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR NOERROR
SECTION QUESTION
. IN NS
SECTION ANSWER
. IN NS K.ROOT-SERVERS.NET.
SECTION ADDITIONAL
K.ROOT-SERVERS.NET. IN A 193.0.14.129
ENTRY_END

ENTRY_BEGIN
MATCH opcode subdomain
ADJUST copy_id copy_query
REPLY QR NOERROR
SECTION QUESTION
com. IN NS
SECTION AUTHORITY
com. IN NS a.gtld-servers.net.
SECTION ADDITIONAL
a.gtld-servers.net. IN A 192.5.6.30
ENTRY_END
RANGE_END

; com TLD server
RANGE_BEGIN 0 100
	ADDRESS 192.5.6.30
ENTRY_BEGIN
MATCH opcode subdomain
ADJUST copy_id copy_query
REPLY QR NOERROR
SECTION QUESTION
example.com. IN NS
SECTION AUTHORITY
example.com. IN NS ns.example.com.
SECTION ADDITIONAL
ns.example.com. IN A 1.2.3.5
ENTRY_END
RANGE_END

; Authoritative server - ONLY responds in time range [0-30]
; After T=30, it doesn't respond (simulating that cache should serve)
RANGE_BEGIN 0 30
	ADDRESS 1.2.3.5
ENTRY_BEGIN
MATCH opcode qname qtype ednsdata
ADJUST copy_id copy_ednsdata_assume_clientsubnet
REPLY QR AA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 10 IN A 1.2.3.10
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	00 08 		; option code = 8 (client subnet)
	00 07 		; length = 7 bytes
	00 01 		; family = IPv4
	18 		; source prefix-length = 24
	00 		; scope prefix-length = 0
	0a 0a 0a 	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END
RANGE_END

;  After T=30, server does NOT respond - any query would timeout
; This proves the answer must come from cache (cachedb or subnetcache)

STEP 1 TIME_PASSES ELAPSE 10

; STEP 10: First query with ECS - goes upstream, populates subnetcache + cachedb
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	00 08		; option code = 8
	00 07		; length = 7
	00 01		; family = IPv4
	18		; source prefix-length = 24
	00		; scope prefix-length = 0
	0a 0a 0a	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

STEP 20 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 10 IN A 1.2.3.10
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	00 08		; option code = 8
	00 07		; length = 7
	00 01		; family = IPv4
	18		; source prefix-length = 24
	18		; scope prefix-length = 24
	0a 0a 0a	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

; STEP 30: Flush the in-memory caches and advance time past upstream availability
; After this, upstream server won't respond (RANGE_END at T=30)
; Also advance past TTL (10 seconds) so caches are expired
STEP 30 FLUSH_MESSAGE www.example.com. IN A
STEP 35 TIME_PASSES ELAPSE 25

; Now we're at T=50, past upstream server's RANGE_END (30)
; Any answer must come from cachedb, not from upstream or subnetcache

; STEP 40: Query again with same ECS subnet
; BEFORE FIX: This will FAIL because:
;   - Subnetcache is cleared (FLUSH_MESSAGE)
;   - Cachedb doesn't have ECS-aware storage
;   - Upstream doesn't respond (past RANGE_END)
;   - Result: SERVFAIL or timeout
;
; AFTER FIX: This will PASS because:
;   - Cachedb has ECS-aware storage
;   - Answer retrieved from cachedb
;   - Result: 1.2.3.10
STEP 40 QUERY
ENTRY_BEGIN
REPLY RD DO
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	00 08		; option code = 8
	00 07		; length = 7
	00 01		; family = IPv4
	18		; source prefix-length = 24
	00		; scope prefix-length = 0
	0a 0a 0a	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

; This CHECK_ANSWER will FAIL with current code (no answer from cachedb)
; and PASS after implementing ECS-aware cachedb
;
; CURRENT: Test fails with "query answer not matched" because:
;   1. Query at T=50 tries to go upstream (cache miss in cachedb)  
;   2. Authoritative server (1.2.3.5) only responds in RANGE [0-30]
;   3. At T=50, server doesn't respond, query remains pending
;   4. CHECK_ANSWER fails because no response was received
;
; AFTER FIX: Test will pass because:
;   1. Cachedb has ECS-aware storage
;   2. Query at T=50 is served directly from cachedb
;   3. Answer: 1.2.3.10 (correct subnet-specific response)
STEP 50 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. IN A 1.2.3.10
SECTION ADDITIONAL
HEX_EDNSDATA_BEGIN
	00 08		; option code = 8
	00 07		; length = 7
	00 01		; family = IPv4
	18		; source prefix-length = 24
	18		; scope prefix-length = 24
	0a 0a 0a	; address = 10.10.10.0
HEX_EDNSDATA_END
ENTRY_END

SCENARIO_END
